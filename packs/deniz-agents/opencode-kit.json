    {
      "file": "agents/code-reviewer.md",
      "id": "code-reviewer",
      "access": {
        "profile": "read-only",
        "escape": "deny"
      }
    },
    {
      "file": "agents/debugger.md",
      "id": "debugger",
      "access": {
        "profile": "read-only",
        "escape": "deny"
      }
    },
    {
      "file": "agents/test-engineer.md",
      "id": "test-engineer",
      "access": {
        "profile": "read-only",
        "escape": "ask"
      }
    }
